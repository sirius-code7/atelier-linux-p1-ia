# ==========================================
# setup_project.sh
# Script d'automatisation de creation d'un
# projet IA sous Linux
# ==========================================

set -e   # arrete le script si une commande echoue

# --- 1. Demander le nom du projet ---
read -p "Nom du projet : " PROJECT_NAME

if [ -z "$PROJECT_NAME" ]; then
    echo "Erreur : le nom du projet ne peut pas etre vide."
    exit 1
fi

# --- 2. Creer l'arborescence ---
echo ">> Creation de l'arborescence..."
mkdir -p "$PROJECT_NAME"/datasets/brut
mkdir -p "$PROJECT_NAME"/datasets/clean
mkdir -p "$PROJECT_NAME"/config
mkdir -p "$PROJECT_NAME"/logs
mkdir -p "$PROJECT_NAME"/scripts
mkdir -p "$PROJECT_NAME"/models
mkdir -p "$PROJECT_NAME"/api
mkdir -p "$PROJECT_NAME"/backup
mkdir -p "$PROJECT_NAME"/documentation
mkdir -p "$PROJECT_NAME"/shared
ARBO_OK="OK"

# --- 3. Creer un fichier de configuration ---
echo ">> Creation du fichier de configuration..."
cat << EOF > "$PROJECT_NAME"/config/settings.conf
PROJECT_NAME=$PROJECT_NAME
DATA_PATH=datasets/brut
MODEL_PATH=models
LOG_LEVEL=INFO
API_PORT=8000
AUTHOR=Equipe IA
EOF
CONFIG_OK="OK"

# --- 4. Installer les outils ---
echo ">> Installation des outils necessaires..."
sudo apt-get update -y > /dev/null
sudo apt-get install -y git curl wget htop tree python3 python3-pip unzip > /dev/null
LOGICIELS_OK="OK"

# --- 5. Telecharger le dataset ---
echo ">> Telechargement du dataset..."
wget -q https://raw.githubusercontent.com/mwaskom/seaborn-data/master/iris.csv -P "$PROJECT_NAME"/datasets/brut/
if [ -f "$PROJECT_NAME/datasets/brut/iris.csv" ]; then
    DATASET_OK="OK"
else
    DATASET_OK="ECHEC"
fi

# --- 6. Compresser le projet ---
echo ">> Compression du projet..."
tar --exclude="$PROJECT_NAME/backup" -czf "$PROJECT_NAME"/backup/"$PROJECT_NAME".tar.gz "$PROJECT_NAME"
ARCHIVE_PATH="$PROJECT_NAME/backup/$PROJECT_NAME.tar.gz"

# --- 7. Afficher un resume ---
echo ""
echo "=========================="
echo "Projet cree"
echo "Nom : $PROJECT_NAME"
echo "Arborescence : $ARBO_OK"
echo "Fichier de config : $CONFIG_OK"
echo "Logiciels : $LOGICIELS_OK"
echo "Dataset : $DATASET_OK"
echo "Archive : $ARCHIVE_PATH"
echo "Installation terminee."
echo "=========================="
